{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/MahlyLeGros/UniSettings"
    },
    "license": "${license}",
    "environment": "client",
    "entrypoints": {
        "client": [
            "io.github.mahlylegros.unisettings.UniSettingsFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_min}",
        "minecraft": "${minecraft_dependency}",
        "java": ">=${target_java}"
    }
}
